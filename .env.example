# ---------------------------------------------------------------------------
# VoltFlow configuration
#
# Copy to .env.local and fill in. With nothing set, the app boots on demo data
# so you can click through it before connecting anything.
# ---------------------------------------------------------------------------

# Internal integration secret from https://www.notion.so/my-integrations
NOTION_TOKEN=

# The page every database is created inside. Paste the page URL or its id.
# Share this page with your integration first: page menu -> Connections.
NOTION_PARENT_PAGE_ID=

# --- Written by `npm run notion:bootstrap` ---------------------------------
# The bootstrap saves ids to .notion-ids.json (gitignored) and prints these
# lines. Set them explicitly when deploying somewhere without that file.
# NOTION_DB_CUSTOMERS=
# NOTION_DB_CONTACTS=
# NOTION_DB_PROPERTIES=
# NOTION_DB_INTERACTIONS=
# NOTION_DB_JOBS=
# NOTION_DB_JOB_PHOTOS=
# NOTION_DB_TASKS=
# NOTION_DB_ESTIMATES=
# NOTION_DB_LINE_ITEMS=
# NOTION_DB_INVOICES=
# NOTION_DB_PAYMENTS=
# NOTION_DB_TECHNICIANS=
# NOTION_DB_TIME_ENTRIES=
# NOTION_DB_MATERIALS=
# NOTION_DB_MATERIAL_USAGE=
# NOTION_DB_VENDORS=
# NOTION_DB_PURCHASE_ORDERS=
# NOTION_DB_PERMITS=
# NOTION_DB_SAFETY=
# NOTION_DB_AGREEMENTS=
# NOTION_DB_ASSETS=
# NOTION_DB_DOCUMENTS=

# Alternative to the individual vars above: one JSON blob.
# NOTION_DATABASE_IDS={"customers":"...","jobs":"..."}
