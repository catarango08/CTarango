# ---------------------------------------------------------------------------
# Tarango Electric field desk
#
# Copy to .env.local. The database ids are already in notion.config.json, so
# the token is the only secret you supply. With nothing set, the app boots on
# sample data shaped like the real OS.
# ---------------------------------------------------------------------------

# Internal integration secret from https://www.notion.so/my-integrations
NOTION_TOKEN=

# Passcode for the app itself. REQUIRED anywhere reachable from the internet —
# without it, anyone with the address can read the customer list and write to
# Notion. Leave blank only on your own machine.
APP_PASSCODE=

# Only needed if the OS page moves. Defaults to notion.config.json.
# NOTION_PARENT_PAGE_ID=3e093196-5321-81ea-b65f-f77bd441f9f6

# --- Overrides ------------------------------------------------------------
# notion.config.json already holds every database id. Set any of these only to
# point the app somewhere else (a scratch workspace, for example).
# NOTION_DB_JOBS=
# NOTION_DB_JOB_PHOTOS=
# NOTION_DB_CUSTOMERS=
# NOTION_DB_HOUR_LEDGER=
# NOTION_DB_RATE_BOOK=
# NOTION_DB_TERRITORY=
# NOTION_DB_PERMITS=
# NOTION_DB_REFERRALS=
# NOTION_DB_EQUIPMENT=

# Alternative: one JSON blob.
# NOTION_DATABASE_IDS={"jobs":"...","customers":"..."}

# --- Card payments (Stripe Checkout) --------------------------------------
# Set these in the host secret store. Never in the repo or in chat.
# See docs/PAYMENTS.md. If any required value is missing, card checkout stays off.
# APP_PASSCODE above is also required before a pay link or webhook is accepted.
# PAYMENT_DATABASE_URL=     # postgres URL for the dedicated payment database only
# STRIPE_SECRET_KEY=        # restricted key (rk_…) preferred; test key until go-live
# STRIPE_ACCOUNT_ID=        # acct_… for this Stripe account
# STRIPE_WEBHOOK_SECRET=    # whsec_… from the webhook endpoint you create
# PAY_LINK_SECRET=          # 32+ random characters; signs customer pay links
# APP_BASE_URL=             # https://your-production-domain (no trailing slash)
# Optional, only once real ids exist (prod_…). Leave unset otherwise:
# STRIPE_PRODUCT_INVOICE=
# STRIPE_PRODUCT_DEPOSIT=
# STRIPE_PRODUCT_CHANGE_ORDER=
# STRIPE_PRODUCT_CARD_FEE=
