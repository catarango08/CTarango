# ============================================
# Family Command Center - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# The app runs in demo mode until these are configured.

# --- Home Assistant ---
# Home Assistant runs on Brittany's MacBook Pro (always-on home server)
# Use the static IP you reserved in your router for reliability.
# Find the IP on Brittany's Mac: ipconfig getifaddr en0
NEXT_PUBLIC_HA_URL=http://192.168.1.42:8123
# Long-Lived Access Token — generate at: HA → Profile → Long-Lived Access Tokens
NEXT_PUBLIC_HA_TOKEN=

# --- Weather (OpenWeatherMap) ---
# Free API key at: https://openweathermap.org/api
WEATHER_API_KEY=
# San Antonio, TX coordinates (update if different)
WEATHER_LAT=29.4241
WEATHER_LON=-98.4936
