# ============================================
# Family Command Center - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values.
# The app runs in demo mode until these are configured.

# --- Home Assistant ---
# Your Home Assistant URL (e.g., http://192.168.1.100:8123 or https://your-ha.duckdns.org)
NEXT_PUBLIC_HA_URL=
# Long-Lived Access Token from Home Assistant
# Generate one at: Your HA Instance → Profile → Long-Lived Access Tokens → Create Token
NEXT_PUBLIC_HA_TOKEN=

# --- Weather (OpenWeatherMap) ---
# Get a free API key at: https://openweathermap.org/api
WEATHER_API_KEY=
# Your location coordinates (defaults to San Antonio, TX)
WEATHER_LAT=29.4241
WEATHER_LON=-98.4936
